<Window x:Class="ChaoDesk.Host.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chao Desk"
        Width="1280" Height="860" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        FontFamily="{DynamicResource BodyFont}"
        FontSize="13"
        Foreground="{DynamicResource InkBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <!-- Our own title bar: the window keeps its frame (snap, shadow, rounded corners on Windows 11), the top strip drags it. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Padding="16,7" Margin="0,0,4,0" Cursor="Hand">
                            <ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{DynamicResource OnAccentBrush}" />
                                <Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="Medium" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Sidebar navigation item: an icon (its Tag, a Segoe Fluent Icons glyph) and the name; the open page in soft accent. -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SideInkBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="{DynamicResource SmallRadius}" Padding="{DynamicResource NavItemPadding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                               Width="18" VerticalAlignment="Center" Foreground="{DynamicResource NavGlyphBrush}" Visibility="{DynamicResource NavGlyphVisibility}" Margin="0,0,12,0" />
                                    <ContentPresenter VerticalAlignment="Center" Visibility="{DynamicResource NavLabelVisibility}" />
                                </StackPanel>
                            </Border>
                            <!-- Marks for the current page: a bar at the left or a line under the label (transparent unless the theme uses them) -->
                            <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,9,0,9" Background="Transparent" />
                            <Border x:Name="Underline" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="12,0,12,3" Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SideHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource NavOnBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource NavOnBorderBrush}" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource NavOnGlyphBrush}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource NavBarBrush}" />
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource NavLineBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource NavOnInkBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SideMutedBrush}" />
            <Setter Property="Margin" Value="12,18,0,6" />
            <Setter Property="Visibility" Value="{DynamicResource NavLabelVisibility}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" RenderOptions.ClearTypeHint="Enabled">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SideLineBrush}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="SidebarDock" Margin="14,22,14,16">
                <StackPanel x:Name="LogoRow" DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,16">
                    <Image x:Name="LogoImage" Width="36" Height="36" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Chao Desk" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="{DynamicResource TitleFont}"
                               Foreground="{DynamicResource SideInkBrush}" Visibility="{DynamicResource NavLabelVisibility}" />
                </StackPanel>
                <!-- Bottom: a quiet version line; a card with an Update button only while a new version waits -->
                <StackPanel DockPanel.Dock="Bottom" Margin="4,14,4,0">
                    <Border x:Name="UpdateCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Padding="16,14" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="SideCardTitle" FontSize="13.5" FontWeight="Medium" TextWrapping="Wrap" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Text="A new version is ready to install." />
                            <Button x:Name="SideUpdateButton" Style="{StaticResource PrimaryButton}" Content="Update" Click="OnSideUpdate"
                                    HorizontalAlignment="Left" Padding="14,5,14,6" Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource SideMutedBrush}" Margin="10,0,0,2" Visibility="{DynamicResource NavLabelVisibility}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="&#xE80F;" GroupName="nav" Content="Overview" IsChecked="True" Checked="OnNavChanged" />
                    <TextBlock Style="{StaticResource NavGroup}" Text="TOOLS" />
                    <RadioButton x:Name="NavLauncher" Style="{StaticResource NavItem}" Tag="&#xE721;" GroupName="nav" Content="Launcher" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavPanel" Style="{StaticResource NavItem}" Tag="&#xE80A;" GroupName="nav" Content="Action panel" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavClipboard" Style="{StaticResource NavItem}" Tag="&#xE77F;" GroupName="nav" Content="Clipboard" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavScreenshot" Style="{StaticResource NavItem}" Tag="&#xE722;" GroupName="nav" Content="Screenshot and OCR" Checked="OnNavChanged" />
                    <TextBlock Style="{StaticResource NavGroup}" Text="WALLPAPER" />
                    <RadioButton x:Name="NavLibrary" Style="{StaticResource NavItem}" Tag="&#xE8F1;" GroupName="nav" Content="Library" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavProperties" Style="{StaticResource NavItem}" Tag="&#xE771;" GroupName="nav" Content="Wallpaper" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavWidgets" Style="{StaticResource NavItem}" Tag="&#xE8A9;" GroupName="nav" Content="Widgets" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavTasks" Style="{StaticResource NavItem}" Tag="&#xE8FD;" GroupName="nav" Content="Tasks" Checked="OnNavChanged" />
                    <TextBlock Style="{StaticResource NavGroup}" Text="APP" />
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Tag="&#xE790;" GroupName="nav" Content="Appearance" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource NavItem}" Tag="&#xE713;" GroupName="nav" Content="General" Checked="OnNavChanged" />
                    <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavItem}" Tag="&#xE9D9;" GroupName="nav" Content="Diagnostics" Checked="OnNavChanged" />
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1">
            <!-- Home: a dashboard of the tools, built in code (BuildHome) -->
            <DockPanel x:Name="HomePage" Margin="40,46,30,22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HomePanel" Margin="0,0,8,12" VerticalAlignment="Top" />
                </ScrollViewer>
            </DockPanel>

            <!-- Launcher and file search -->
            <DockPanel x:Name="LauncherPage" Margin="40,46,30,22" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="0,0,8,26">
                    <StackPanel Margin="0,0,260,0">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Launcher" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="One search box for apps, files, commands and quick sums." FontSize="14" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Style="{StaticResource SegmentBar}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LauncherTabSettings" Style="{StaticResource SegmentTab}" GroupName="launcherTabs" Content="Settings" IsChecked="True" Checked="OnLauncherTab" />
                            <RadioButton x:Name="LauncherTabHelp" Style="{StaticResource SegmentTab}" GroupName="launcherTabs" Content="How to search" Checked="OnLauncherTab" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid>
                    <ScrollViewer x:Name="LauncherSettingsView" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,12">
                            <!-- The hotkey: big keycaps; clicking them (or Change) records a new combination -->
                            <Border Style="{StaticResource Card}" Padding="28,26">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Global hotkey" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="Press it anywhere to open the launcher" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Works in any app. Press it again to close." Margin="0,4,0,0" />
                                        <TextBlock x:Name="LauncherHotkeyError" Style="{StaticResource SettingHint}" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Click and press a new combination. Backspace turns it off.">
                                        <Border x:Name="LauncherHotkeyFrame" CornerRadius="16" Padding="6" BorderThickness="2" BorderBrush="Transparent">
                                            <StackPanel x:Name="LauncherHotkeyCaps" Orientation="Horizontal" />
                                        </Border>
                                        <TextBox x:Name="LauncherHotkeyBox" Tag="launcher" Opacity="0" BorderThickness="0" Background="Transparent" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="2" Margin="-7,7,-7,0">
                                <Border Style="{StaticResource Card}" Padding="22,20" Margin="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconTileGlyph}" Text="&#xE8A5;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                            <TextBlock Style="{StaticResource SettingLabel}" Text="Search files and folders" />
                                            <TextBlock Style="{StaticResource SettingHint}" Text="Finds any file as you type, like Everything." Margin="0,4,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="FileSearchCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Click="OnFileSearchToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="22,20" Margin="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconTileGlyph}" Text="&#xE895;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                            <TextBlock Style="{StaticResource SettingLabel}" Text="Index" />
                                            <DockPanel Margin="0,4,0,0">
                                                <Ellipse x:Name="FileSearchDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,7,7,0" VerticalAlignment="Top" />
                                                <TextBlock x:Name="FileSearchStatusText" Style="{StaticResource SettingHint}" Margin="0" />
                                            </DockPanel>
                                        </StackPanel>
                                        <Button x:Name="FileSearchSetupButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Set up…" Click="OnFileSearchSetup"
                                                VerticalAlignment="Top" Padding="15,7,15,8" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="22,20" Margin="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconTileGlyph}" Text="&#xE7B3;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                            <TextBlock Style="{StaticResource SettingLabel}" Text="Include hidden and system files" />
                                            <TextBlock Style="{StaticResource SettingHint}" Text="Also shows hidden files such as the Recycle Bin." Margin="0,4,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="FileHiddenCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Click="OnFileHiddenToggled" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="22,20" Margin="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}"><TextBlock Style="{StaticResource IconTileGlyph}" Text="&#xE8FF;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                            <TextBlock Style="{StaticResource SettingLabel}" Text="Quick Look with Space" />
                                            <TextBlock Style="{StaticResource SettingHint}" Text="Select a file in Explorer and press Space to preview it." Margin="0,4,0,0" />
                                        </StackPanel>
                                        <CheckBox x:Name="QuickLookCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Top" Click="OnQuickLookToggled" />
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <!-- Excluded folders as removable pills; the last pill switches the bulky system folders -->
                            <Border Style="{StaticResource Card}" Padding="22,20" Margin="0,7,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource IconTile}" VerticalAlignment="Center"><TextBlock Style="{StaticResource IconTileGlyph}" Text="&#xE8B7;" /></Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SettingLabel}" Text="Excluded folders" />
                                            <TextBlock Style="{StaticResource SettingHint}" Text="Nothing inside these folders shows up in search results." Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="OnAddExcludedFolder" VerticalAlignment="Center" Padding="14,7,16,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,1,7,0" />
                                                <TextBlock Text="Add" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <WrapPanel x:Name="ExcludedPanel" Margin="52,16,0,0">
                                        <CheckBox x:Name="FileSkipJunkCheck" Style="{StaticResource ChipToggle}" Content="Skip bulky system folders" Click="OnFileSkipJunkToggled"
                                                  ToolTip="Leaves out node_modules and C:\Windows\WinSxS, which saves a lot of memory." />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="LauncherHelpView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <Border Style="{StaticResource Card}" Padding="26,20" Margin="0,0,8,12" VerticalAlignment="Top">
                            <!-- Filled in code (SettingsWindow.FillHelpTexts): one table entry per line -->
                            <TextBlock x:Name="SearchHelpText" Style="{StaticResource SettingHint}" FontSize="13" LineHeight="24" Margin="0" MaxWidth="820" />
                        </Border>
                    </ScrollViewer>
                </Grid>
            </DockPanel>

            <!-- Clipboard -->
            <DockPanel x:Name="ClipboardPage" Margin="40,46,30,22" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,8,18">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Clipboard" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Everything you copy, ready to paste again." />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Keep a clipboard history" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Text, images and copied files. Stored only on this computer." />
                                    </StackPanel>
                                    <CheckBox x:Name="ClipboardCheck" Style="{StaticResource ToggleSwitch}" Click="OnClipboardToggled" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Hotkey" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Shift+` is the ~ key. Press it again to close the history." />
                                        <TextBlock x:Name="ClipboardHotkeyError" Style="{StaticResource SettingHint}" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBox x:Name="ClipboardHotkeyBox" Style="{StaticResource FieldText}" Width="160" Tag="clipboard" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Keep" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="The oldest entries go first. Pinned entries (Ctrl+P) are always kept." />
                                    </StackPanel>
                                    <ComboBox x:Name="ClipboardSizeCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnClipboardSizeChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Never record copies from" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Copies from these apps are not recorded. Separate with commas; Enter applies." />
                                    </StackPanel>
                                    <TextBox x:Name="IgnoredAppsBox" Style="{StaticResource FieldText}" Width="200" LostFocus="OnIgnoredAppsChanged" KeyDown="OnIgnoredAppsKey" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="History" />
                                        <TextBlock x:Name="ClipboardCountText" Style="{StaticResource SettingHint}" />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Clear (keep pinned)" Click="OnClearClipboard" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Keys in the history" />
                        <Border Style="{StaticResource Card}" Padding="18,12">
                            <TextBlock Style="{StaticResource SettingHint}" FontSize="12.5" LineHeight="21" Margin="0"
                                       Text="Enter pastes into the window you came from · Shift+Enter pastes as plain text · Ctrl+C only copies · Ctrl+P pins · Del removes · Ctrl+1…9 pastes an entry · Tab switches All / Pinned / Text / Images / Files · double-click pastes." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Quick panel configuration lives in the main application. -->
            <DockPanel x:Name="PanelPage" Margin="40,46,30,22" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,8,16">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Action panel" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Its actions and how it opens. Its look follows the theme in Appearance." />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,12">
                        <!-- How it opens: the hotkey and the mouse gesture -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel x:Name="PanelHotkeysPanel" />
                                <Separator Style="{StaticResource RowSeparator}" />
                                <StackPanel x:Name="PanelOptionsPanel" />
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Look" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Glass or the theme's own look, with a preview." />
                                    </StackPanel>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Change in Appearance" Click="OnPanelLook" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Actions" />
                        <ContentControl x:Name="PanelActionsHost" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Screenshot -->
            <DockPanel x:Name="ScreenshotPage" Margin="40,46,30,22" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,8,18">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Screenshot" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Capture, mark up, pin to the screen. Copies also land in the clipboard history." />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,12">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Hotkeys" Margin="4,0,0,8" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="ScreenshotHotkeysPanel" />
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Saving" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="File format" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="PNG is lossless, JPEG is smaller. Copies always keep full quality." />
                                    </StackPanel>
                                    <ComboBox x:Name="ShotFormatCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnShotFormatChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <StackPanel Margin="0,10">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Open" Click="OnOpenShotFolder" Margin="8,0,0,0" VerticalAlignment="Top" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Change…" Click="OnChangeShotFolder" VerticalAlignment="Top" />
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource SettingLabel}" Text="Folder" />
                                            <TextBlock x:Name="ShotFolderText" Style="{StaticResource SettingHint}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Save every copied screenshot" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Also save each screenshot you copy. Off: press Ctrl+S to save one." />
                                    </StackPanel>
                                    <CheckBox x:Name="ShotAutoSaveCheck" Style="{StaticResource ToggleSwitch}" Click="OnShotTogglesChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Save quick screenshots" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Also save quick screenshots to the folder." />
                                    </StackPanel>
                                    <CheckBox x:Name="ShotQuickSaveCheck" Style="{StaticResource ToggleSwitch}" Click="OnShotTogglesChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Text recognition (OCR)" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Read with" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Which language packs read the text." />
                                    </StackPanel>
                                    <ComboBox x:Name="OcrLanguageCombo" Style="{StaticResource FieldCombo}" Width="220" SelectionChanged="OnOcrChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="After recognising" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Open the text window, or copy the text straight away." />
                                    </StackPanel>
                                    <ComboBox x:Name="OcrAfterCombo" Style="{StaticResource FieldCombo}" Width="200" SelectionChanged="OnOcrChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Join lines into paragraphs" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Merge wrapped lines into paragraphs." />
                                    </StackPanel>
                                    <CheckBox x:Name="OcrMergeCheck" Style="{StaticResource ToggleSwitch}" Click="OnOcrChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Translate automatically" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Show the translation as soon as the text is recognised." />
                                    </StackPanel>
                                    <CheckBox x:Name="OcrTranslateCheck" Style="{StaticResource ToggleSwitch}" Click="OnOcrChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="OCR languages" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,10,0,4" TextWrapping="Wrap"
                                           Text="Chinese, English and Japanese are built in. Add a language and it is downloaded once (8–14 MB), then works offline; remove it to free the space." />
                                <StackPanel x:Name="OcrPacksPanel" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="In the capture" />
                        <Border Style="{StaticResource Card}" Padding="18,12">
                            <!-- Filled in code (SettingsWindow.FillHelpTexts): one table entry per line -->
                            <TextBlock x:Name="CaptureHelpText" Style="{StaticResource SettingHint}" FontSize="12.5" LineHeight="21" Margin="0" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Library -->
            <DockPanel x:Name="LibraryPage" Margin="40,46,30,22" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="0,0,8,18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Library" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Click a wallpaper to use it on all displays." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource SecondaryButton}" Content="Import folder…" Click="OnImportFolder" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Import .zip…" Click="OnImportZip" />
                    </StackPanel>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="LibraryPanel" Margin="0,0,0,12" />
                </ScrollViewer>
            </DockPanel>

            <!-- Wallpaper properties -->
            <DockPanel x:Name="PropertiesPage" Margin="40,46,30,22" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="0,0,8,18">
                    <StackPanel>
                        <TextBlock x:Name="PropertiesTitle" Style="{StaticResource PageTitle}" Text="Wallpaper" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Changes apply to the desktop immediately." />
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButton}" Content="Reset to defaults" Click="OnResetProperties"
                            HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,12">
                        <StackPanel x:Name="PropertiesPanel" />
                    </Border>
                </ScrollViewer>
            </DockPanel>

            <!-- Widgets -->
            <DockPanel x:Name="WidgetsPage" Margin="40,46,30,22" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,8,18">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Widgets" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Choose what the card on the desktop shows, and in which order." />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,12">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Card display" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Clock until clicked: a small clock in the corner opens the card." />
                                    </StackPanel>
                                    <ComboBox x:Name="DisplayCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnDisplayChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Layout" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Stacked shows widgets one below another; tabs show one at a time." />
                                    </StackPanel>
                                    <ComboBox x:Name="LayoutCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnLayoutChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Widgets per page" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="The most widgets on one page in the stacked layout." />
                                    </StackPanel>
                                    <ComboBox x:Name="PerPageCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnPerPageChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Widgets" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="WidgetsPanel" />
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Shortcuts" />
                        <Border Style="{StaticResource Card}" Padding="12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Text="Shown by the Shortcuts widget. A web address (boc.cn, https://…) or the full path of a folder or program (use Browse)." />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Add" Click="OnAddShortcut" Margin="8,0,0,0" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Folder…" Click="OnBrowseFolder" Margin="8,0,0,0" />
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Program…" Click="OnBrowseProgram" Margin="8,0,0,0" />
                                    <TextBox x:Name="ShortcutNameBox" DockPanel.Dock="Left" Width="130" Height="32" VerticalContentAlignment="Center" Padding="8,0" MaxLength="20"
                                             BorderBrush="{DynamicResource LineBrush}" ToolTip="Name (optional)" Margin="0,0,8,0" />
                                    <TextBox x:Name="ShortcutTargetBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" MaxLength="400"
                                             BorderBrush="{DynamicResource LineBrush}" ToolTip="Web address, folder or program" KeyDown="OnShortcutKey" />
                                </DockPanel>
                                <TextBlock x:Name="ShortcutError" Foreground="{DynamicResource DangerBrush}" Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                                <StackPanel x:Name="ShortcutsPanel" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Tasks -->
            <DockPanel x:Name="TasksPage" Margin="40,46,30,22" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="0,0,8,18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Tasks" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="Shown by the Tasks widget (turn it on under Widgets). Click a task on the desktop to tick it off." />
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButton}" Content="Clear completed" Click="OnClearDone" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,8,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Add" Click="OnAddTask" Margin="10,0,0,0" />
                        <TextBox x:Name="NewTaskBox" Height="32" VerticalContentAlignment="Center" Padding="8,0" MaxLength="120" KeyDown="OnNewTaskKey" BorderBrush="{DynamicResource LineBrush}" />
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,12">
                        <StackPanel x:Name="TasksPanel" />
                    </Border>
                </ScrollViewer>
            </DockPanel>

            <!-- General -->
            <DockPanel x:Name="AppearancePage" Margin="40,46,30,22" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,8,18">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Appearance" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="Themes, colours, fonts and the sidebar. Changes show at once." />
                </StackPanel>
                <ScrollViewer x:Name="AppearanceScroll" VerticalScrollBarVisibility="Auto">
                    <!-- Filled in code (BuildAppearance) -->
                    <StackPanel x:Name="AppearancePanel" Margin="0,0,8,12" />
                </ScrollViewer>
            </DockPanel>
            <DockPanel x:Name="GeneralPage" Margin="40,46,30,22" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,8,18">
                    <TextBlock Style="{StaticResource PageTitle}" Text="General" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="The wallpaper, performance, pausing and startup." />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,12">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Language" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="The language of Chao Desk's windows, menus and desktop widgets." />
                                </StackPanel>
                                <ComboBox x:Name="LanguageCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnLanguageChanged" />
                            </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Show the interactive wallpaper" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="Off: only the tools run, and your Windows wallpaper shows." />
                                </StackPanel>
                                <CheckBox x:Name="WallpaperCheck" Style="{StaticResource ToggleSwitch}" Click="OnGeneralChanged" />
                            </Grid>
                            <Separator Style="{StaticResource RowSeparator}" />
                            <Grid Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SettingLabel}" Text="Keep the widgets without the wallpaper" />
                                    <TextBlock Style="{StaticResource SettingHint}" Text="Clock, calendar and weather stay on the desktop with the wallpaper off." />
                                </StackPanel>
                                <CheckBox x:Name="DesktopWidgetsCheck" Style="{StaticResource ToggleSwitch}" Click="OnGeneralChanged" />
                            </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Performance" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Frame rate limit" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="30 FPS is smooth for a wallpaper and uses half the power of 60." />
                                    </StackPanel>
                                    <ComboBox x:Name="FpsCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnGeneralChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Render scale" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Lower is lighter on the graphics card; 75 % looks almost the same." />
                                    </StackPanel>
                                    <ComboBox x:Name="ScaleCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnGeneralChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Quality" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Auto lowers effects if frames take too long." />
                                    </StackPanel>
                                    <ComboBox x:Name="QualityCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnGeneralChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Pausing" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Pause when a window is maximised" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Full-screen apps always pause the wallpaper on their display." />
                                    </StackPanel>
                                    <CheckBox x:Name="PauseMaxCheck" Style="{StaticResource ToggleSwitch}" Click="OnGeneralChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Pause on battery" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Battery saver always pauses the wallpaper." />
                                    </StackPanel>
                                    <CheckBox x:Name="PauseBatteryCheck" Style="{StaticResource ToggleSwitch}" Click="OnGeneralChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Interaction and startup" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Enable mouse interaction" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Clicks on empty desktop space reach the wallpaper, e.g. to feed the koi." />
                                    </StackPanel>
                                    <CheckBox x:Name="MouseCheck" Style="{StaticResource ToggleSwitch}" Click="OnGeneralChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Start with Windows" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Launch Chao Desk when you sign in." />
                                    </StackPanel>
                                    <CheckBox x:Name="StartupCheck" Style="{StaticResource ToggleSwitch}" Click="OnGeneralChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Online info" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Exchange rates, holidays and weather for the widgets, every 30 minutes." />
                                    </StackPanel>
                                    <CheckBox x:Name="OnlineCheck" Style="{StaticResource ToggleSwitch}" Click="OnGeneralChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Weather city" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="For example 北京 or Sydney; empty: no weather. Enter applies." />
                                    </StackPanel>
                                    <TextBox x:Name="CityBox" Style="{StaticResource FieldText}" Width="160" MaxLength="60" LostFocus="OnGeneralChanged" KeyDown="OnCityKey" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Translation" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Translate into" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="For the Translate button and Ctrl+T. Automatic: Chinese ↔ English." />
                                    </StackPanel>
                                    <ComboBox x:Name="TranslateTargetCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnTranslateChanged" />
                                </Grid>
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Translation service" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Free, no account. Text is sent only when you translate." />
                                    </StackPanel>
                                    <ComboBox x:Name="TranslateEngineCombo" Style="{StaticResource FieldCombo}" SelectionChanged="OnTranslateChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Updates" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock x:Name="UpdateTitle" Style="{StaticResource SettingLabel}" />
                                        <TextBlock x:Name="UpdateStatusText" Style="{StaticResource SettingHint}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0">
                                        <Button x:Name="UpdateCancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel" Click="OnCancelUpdate" Margin="0,0,8,0" Visibility="Collapsed" />
                                        <Button x:Name="UpdateButton" Style="{StaticResource SecondaryButton}" Click="OnUpdateButton" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="UpdateNotesText" Style="{StaticResource SettingHint}" Margin="0,0,0,12" MaxHeight="180" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                <Separator Style="{StaticResource RowSeparator}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SettingLabel}" Text="Check for updates automatically" />
                                        <TextBlock Style="{StaticResource SettingHint}" Text="Once a day. Nothing is downloaded until you choose to install." />
                                    </StackPanel>
                                    <CheckBox x:Name="AutoUpdateCheck" Style="{StaticResource ToggleSwitch}" Click="OnGeneralChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Diagnostics -->
            <DockPanel x:Name="DiagnosticsPage" Margin="40,46,30,22" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="0,0,8,18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Diagnostics" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="What Chao Desk sees on this computer." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="DevToolsButton" Style="{StaticResource SecondaryButton}" Content="Open DevTools" Click="OnOpenDevTools" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Reload wallpaper" Click="OnReload" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Open log folder" Click="OnOpenLogs" />
                    </StackPanel>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,12">
                        <StackPanel x:Name="DiagnosticsPanel" />
                    </Border>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Title bar buttons, over the pages' top right corner -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" />
            <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Click="OnCloseWindow" />
        </StackPanel>
    </Grid>
</Window>
