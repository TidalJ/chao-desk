<!-- Light theme, "celadon": a celadon-white page, white cards with a hairline, ink text and one deep celadon accent
     used only on the things you act on. Every window refers to these keys with DynamicResource, so switching
     dictionaries (ThemeManager) recolours open windows. Dark.xaml has the same keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PaperBrush" Color="#F5F8F6" />
    <SolidColorBrush x:Key="PageBrush" Color="#F5F8F6" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3EAE7" />
    <SolidColorBrush x:Key="PopupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F5F8F6" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InkBrush" Color="#1C2522" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6E7B76" />
    <SolidColorBrush x:Key="LineBrush" Color="#E3EAE7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2E6B5E" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#25594E" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E9F1EE" />
    <SolidColorBrush x:Key="AccentFaintBrush" Color="#D6E6E0" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B8433F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E8A5E" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0A1C2522" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F2F4F3" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E6ECE9" />
    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#D8E2DE" />
    <SolidColorBrush x:Key="ToggleBorderBrush" Color="#D8E2DE" />
    <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FooterBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#9AA6A1" />
    <SolidColorBrush x:Key="TileBrush" Color="#F1F2F2" />
    <SolidColorBrush x:Key="KeycapBrush" Color="#F1F2F2" />
    <SolidColorBrush x:Key="PreviewBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#EEF0EF" />
    <SolidColorBrush x:Key="ChartRestBrush" Color="#E4E7E6" />
    <!-- The home banner's veil: the page colour, opaque on the left (behind the greeting), clear on the right. -->
    <LinearGradientBrush x:Key="HeroVeilBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F5F5F8F6" Offset="0" />
        <GradientStop Color="#DBF5F8F6" Offset="0.34" />
        <GradientStop Color="#40F5F8F6" Offset="0.62" />
        <GradientStop Color="#00F5F8F6" Offset="0.8" />
    </LinearGradientBrush>
    <Color x:Key="ShadowColor">#1C2522</Color>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="ShadowOpacity">0.06</sys:Double>
    <!-- Settings cards: the card colour, see-through in themes with a backdrop. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <!-- Filled accents (main buttons, switches, the chart's today bar): a gradient in some themes. -->
    <LinearGradientBrush x:Key="AccentFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E6B5E" Offset="0" />
        <GradientStop Color="#2E6B5E" Offset="1" />
    </LinearGradientBrush>
    <FontFamily x:Key="TitleFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>
    <!-- Shapes, density, fonts and the sidebar: ThemeManager writes all of these per theme; these are fallbacks. -->
    <CornerRadius x:Key="CardRadius">18</CornerRadius>
    <CornerRadius x:Key="ControlRadius">18</CornerRadius>
    <CornerRadius x:Key="ToggleRadius">12</CornerRadius>
    <CornerRadius x:Key="ThumbRadius">9</CornerRadius>
    <CornerRadius x:Key="SmallRadius">10</CornerRadius>
    <Thickness x:Key="RowMargin">0,12</Thickness>
    <Thickness x:Key="CardPadding">22,6</Thickness>
    <Thickness x:Key="NavItemPadding">12,8</Thickness>
    <FontFamily x:Key="GreetingFont">Georgia, Noto Serif SC, Source Han Serif SC, SimSun</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <SolidColorBrush x:Key="SideLineBrush" Color="#E3EAE7" />
    <SolidColorBrush x:Key="SideInkBrush" Color="#1C2522" />
    <SolidColorBrush x:Key="SideMutedBrush" Color="#6E7B76" />
    <SolidColorBrush x:Key="SideHoverBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="NavGlyphBrush" Color="#6E7B76" />
    <SolidColorBrush x:Key="NavOnBorderBrush" Color="#E3EAE7" />
    <SolidColorBrush x:Key="NavOnInkBrush" Color="#1C2522" />
    <SolidColorBrush x:Key="NavOnGlyphBrush" Color="#2E6B5E" />
    <SolidColorBrush x:Key="NavBarBrush" Color="#00000000" />
    <SolidColorBrush x:Key="NavLineBrush" Color="#00000000" />
    <LinearGradientBrush x:Key="NavOnBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <Visibility x:Key="NavGlyphVisibility">Visible</Visibility>
    <Visibility x:Key="NavLabelVisibility">Visible</Visibility>
</ResourceDictionary>
