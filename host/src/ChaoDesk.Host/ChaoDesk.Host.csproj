<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ChaoDesk</AssemblyName>
    <RootNamespace>ChaoDesk.Host</RootNamespace>
    <Version>1.4.0</Version>
    <Product>Chao Desk</Product>
    <ApplicationIcon>Assets\chaodesk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\chaodesk.ico" />
    <EmbeddedResource Include="Assets\home-hero.jpg" />
    <EmbeddedResource Include="Assets\hero-summer.jpg" />
    <EmbeddedResource Include="Assets\hero-autumn.jpg" />
    <Resource Include="Panel\GlassLens.ps" />
    <Resource Include="Panel\GlassGlyph.ps" />
    <Resource Include="Panel\Maps\*.jpg;Panel\Maps\*.png;Panel\Maps\LICENSE.txt" />
    <EmbeddedResource Include="Panel\Maps\LIQUID-GLASS-STUDIO-LICENSE.txt" />
    <EmbeddedResource Include="Launcher\pinyin.txt" />
    <EmbeddedResource Include="Localization\zh\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ChaoDesk.Host.Tests" />
  </ItemGroup>

  <!-- PP-OCRv5 models (fetched by build.ps1 from models/ocr/models.json), shipped in the app's ocr folder. -->
  <ItemGroup>
    <None Include="..\..\..\models\ocr\*.onnx;..\..\..\models\ocr\*.txt" Link="ocr\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Always refresh the built-in static package, even for dotnet build/test. A stale Debug
       wallpaper used to silently overwrite the installed scene selector during app-only updates. -->
  <ItemGroup>
    <Content Include="..\..\..\wallpapers\lotus-pond\**\*"
             Exclude="..\..\..\wallpapers\lotus-pond\tests\**;..\..\..\wallpapers\lotus-pond\node_modules\**"
             Link="wallpapers\lotus-pond\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>


</Project>
