<Window x:Class="ChaoDesk.Host.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chao Desk"
        Width="880" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Background="{DynamicResource PopupBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Foreground="{DynamicResource InkBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- A result row with its section title ("Best match", "Files"…) above it, outside the highlight. -->
        <Style x:Key="LauncherRow" TargetType="ListBoxItem" BasedOn="{StaticResource PopupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel>
                            <TextBlock x:Name="Head" Text="{Binding Header}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="22,12,12,6" />
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="12" Margin="10,1" Padding="12,0">
                                <ContentPresenter />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Header}" Value="">
                                <Setter TargetName="Head" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <Trigger SourceName="Bg" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="Root">
        <!-- The search box alone: filters, sort and the details switch live in the footer -->
        <Grid DockPanel.Dock="Top" Height="64" Margin="22,2,20,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The search icon (and the footer) move the window, as in the clipboard -->
            <Border Background="Transparent" Padding="0,10" Cursor="SizeAll" ToolTip="Drag to move" VerticalAlignment="Center" MouseLeftButtonDown="OnMoveAreaMouseDown">
                <Path Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.8"
                      Data="M 10,2 A 8,8 0 1 1 9.99,2 Z M 16,16 L 22,22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Border>
            <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="14,0,0,0" FontSize="21" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource PlaceholderBrush}" Text="Search apps and files" />
            <TextBox x:Name="QueryBox" Grid.Column="1" Margin="12,0,8,0" Style="{StaticResource PopupSearchBox}" TextChanged="OnQueryChanged" />
        </Grid>

        <!-- Footer (drag it to move the window): the filters on the left, then the keys or a status line; sort, the
             details switch and clear history on the right -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8,14,8" Background="{DynamicResource FooterBrush}"
                Cursor="SizeAll" MouseLeftButtonDown="OnMoveAreaMouseDown">
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="{DynamicResource TileBrush}" Padding="3" VerticalAlignment="Center" Cursor="Arrow"
                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}">
                    <StackPanel x:Name="FilterPanel" Orientation="Horizontal" />
                </Border>
                <StackPanel x:Name="ToolsPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Arrow" />
                <TextBlock x:Name="ClearHistoryLink" DockPanel.Dock="Right" Text="Clear history" FontSize="12" Margin="16,0,8,0" Cursor="Hand"
                           Foreground="{DynamicResource InkBrush}" TextDecorations="Underline" Visibility="Collapsed" VerticalAlignment="Center"
                           ToolTip="Forget recently used apps and commands" MouseLeftButtonUp="OnClearHistoryClick" />
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="16,0,8,0" />
            </DockPanel>
        </Border>

        <!-- Results -->
        <!-- A fixed height: results and previews of any size never move or resize the window. -->
        <Border x:Name="ResultsHost" Height="480" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
          <Grid>
            <!-- The list keeps its width; with the details off the window is just the list. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Results" Style="{StaticResource PopupList}" ItemContainerStyle="{StaticResource LauncherRow}" Margin="0,2,0,6"
                     PreviewMouseLeftButtonDown="OnResultMouseDown" PreviewMouseRightButtonDown="OnResultRightDown" SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Tile" Width="34" Height="34" Background="Transparent" VerticalAlignment="Center">
                                <Image Source="{Binding Icon}" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Sub" Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="HintText" Grid.Column="2" Text="{Binding Hint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <!-- Recent rows: a remove button while the row is hovered or selected -->
                            <Border x:Name="Forget" Grid.Column="3" Tag="forget" Width="26" Height="26" Margin="8,0,0,0" Background="Transparent" CornerRadius="8"
                                    Cursor="Hand" ToolTip="Remove from history (Del)" Visibility="Collapsed">
                                <TextBlock Tag="forget" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- The selected row says what Enter does ("↵ Open", "↵ Copy") instead of its hint -->
                            <Border x:Name="EnterCap" Grid.Column="4" Margin="8,0,0,0" Padding="9,3,10,4" CornerRadius="8" VerticalAlignment="Center"
                                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentFaintBrush}" BorderThickness="1" Visibility="Collapsed"
                                    ToolTip="Keys: Enter open · Ctrl+Enter show in folder · Shift+Enter Quick Look · Ctrl+S sort files · Tab next filter · right-click for more">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↵" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ActionLabel}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="EnterCap" Property="Visibility" Value="Visible" />
                                <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="TitleText" Property="FontWeight" Value="Medium" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FromHistory}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Forget" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FromHistory}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Forget" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <Trigger SourceName="Forget" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Forget" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Subtitle}" Value="">
                                <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoResults" Text="No matches" FontSize="13" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <!-- Details of the selected result: a preview for files, facts for apps and commands -->
            <Border x:Name="PreviewHost" Grid.Column="1" Padding="6,14,20,12">
                <Border Background="{DynamicResource PreviewBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="18,16,14,10">
                            <TextBlock x:Name="PreviewDetails" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PreviewTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                        </StackPanel>
                        <ContentControl x:Name="PreviewSlot" Margin="4,0,4,4" />
                    </DockPanel>
                </Border>
            </Border>
          </Grid>
        </Border>
    </DockPanel>
</Window>
