<Window x:Class="ChaoDesk.Host.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chao Desk"
        Width="1080" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Background="{DynamicResource PaperBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        FontSize="13"
        Foreground="{DynamicResource InkBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <DockPanel x:Name="Root">
        <!-- Search box -->
        <Grid DockPanel.Dock="Top" Height="60" Margin="20,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The search icon (and the footer) move the window, as in the clipboard -->
            <Border Background="Transparent" Padding="0,10" Cursor="SizeAll" ToolTip="Drag to move" VerticalAlignment="Center" MouseLeftButtonDown="OnMoveAreaMouseDown">
                <Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2"
                      Data="M 10,2 A 8,8 0 1 1 9.99,2 Z M 16,16 L 22,22" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Border>
            <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="14,0,0,0" FontSize="20" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource PlaceholderBrush}" Text="Search apps and files" />
            <TextBox x:Name="QueryBox" Grid.Column="1" Margin="12,0,8,0" Style="{StaticResource PopupSearchBox}" TextChanged="OnQueryChanged" />
            <StackPanel x:Name="FilterPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />
        </Grid>

        <!-- Footer: status and keys -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,7,18,8" Background="{DynamicResource FooterBrush}"
                Cursor="SizeAll" MouseLeftButtonDown="OnMoveAreaMouseDown">
            <DockPanel>
                <TextBlock x:Name="ClearHistoryLink" DockPanel.Dock="Right" Text="Clear history" FontSize="11.5" Margin="16,0,0,0" Cursor="Hand"
                           Foreground="{DynamicResource InkBrush}" TextDecorations="Underline" Visibility="Collapsed"
                           ToolTip="Forget recently used apps and commands (pins stay)" MouseLeftButtonUp="OnClearHistoryClick" />
                <TextBlock x:Name="KeysText" DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="16,0,0,0" />
                <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Results -->
        <!-- A fixed height: results and previews of any size never move or resize the window. -->
        <Border x:Name="ResultsHost" Height="480" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
          <Grid>
            <!-- The list keeps its width; with the details off the window is just the list. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="640" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Results" Style="{StaticResource PopupList}" ItemContainerStyle="{StaticResource PopupItem}" Margin="0,6"
                     PreviewMouseLeftButtonDown="OnResultMouseDown" PreviewMouseRightButtonDown="OnResultRightDown" SelectionChanged="OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="Sub" Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Hint}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <!-- Recent rows: a remove button while the row is hovered or selected -->
                            <Border x:Name="Forget" Grid.Column="3" Tag="forget" Width="26" Height="26" Margin="8,0,0,0" Background="Transparent"
                                    Cursor="Hand" ToolTip="Remove from history (Del)" Visibility="Collapsed">
                                <TextBlock Tag="forget" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FromHistory}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Forget" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FromHistory}" Value="True" />
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Forget" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <Trigger SourceName="Forget" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Forget" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Subtitle}" Value="">
                                <Setter TargetName="Sub" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoResults" Text="No matches" FontSize="13" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <!-- Details of the selected result: a preview for files, facts for apps and commands -->
            <Border x:Name="PreviewHost" Grid.Column="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Background="{DynamicResource PreviewBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,9,10,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock x:Name="PreviewTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PreviewDetails" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <ContentControl x:Name="PreviewSlot" />
                </DockPanel>
            </Border>
          </Grid>
        </Border>
    </DockPanel>
</Window>
